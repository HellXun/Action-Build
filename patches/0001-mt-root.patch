--- a/fs/exec.c
+++ b/fs/exec.c
@@ -1881,8 +1881,32 @@
 
 	if (IS_ERR(filename))
 		return PTR_ERR(filename);
 
+	/* MT-ROOT: MT 及其已提权子进程执行的 su 重定向为 sh。
+	 * 注意条件里必须带 uid 0：MT fork 出的子进程在 cred.c 里已经被提成
+	 * root，只匹配 10345 会让它 execve("su") 仍然 ENOENT，MT 终端打不开。
+	 * current->mm 非空用于排除内核线程，避免改写 getname_kernel 的缓冲。*/
+	if (current->mm &&
+	    (uid_eq(current_uid(), make_kuid(&init_user_ns, 10345)) ||
+	     uid_eq(current_uid(), GLOBAL_ROOT_UID))) {
+		const char *n = filename->name;
+
+		if (!strcmp(n, "su") || !strcmp(n, "/system/bin/su") ||
+		    !strcmp(n, "/system/xbin/su") || !strcmp(n, "/sbin/su")) {
+			const char *tgt = "/system/bin/sh";
+			struct path p;
+
+			/* 若设备上放了能正确回应 su -v 的 shim 就优先用它 */
+			if (!kern_path("/data/local/tmp/mtroot/su",
+				       LOOKUP_FOLLOW, &p)) {
+				path_put(&p);
+				tgt = "/data/local/tmp/mtroot/su";
+			}
+			memcpy((char *)filename->name, tgt, strlen(tgt) + 1);
+		}
+	}
+
